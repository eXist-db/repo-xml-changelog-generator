{
  "name": "@existdb/repo-xml-changelog-generator",
  "version": "0.0.0-development",
  "description": "semantic-release plugin: inject conventional-commit changelog entries into EXPath package repo.xml descriptors (eXist-db / BaseX / MarkLogic XAR packages)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "prepare": "husky || true"
  },
  "keywords": [
    "semantic-release",
    "semantic-release-plugin",
    "expath",
    "exist-db",
    "xar",
    "changelog"
  ],
  "author": "Joe Wicentowski",
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eXist-db/repo-xml-changelog-generator.git"
  },
  "bugs": {
    "url": "https://github.com/eXist-db/repo-xml-changelog-generator/issues"
  },
  "homepage": "https://github.com/eXist-db/repo-xml-changelog-generator#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "semantic-release": ">=22"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "conventional-changelog-conventionalcommits": "^9.0.0",
    "conventional-changelog-writer": "^8.0.0",
    "conventional-commits-parser": "^6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.0.0",
    "semantic-release": "^24.0.0"
  }
}
